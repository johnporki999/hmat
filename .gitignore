# ─────────────────────────────────────────────────────────────────────────────
# To repo jest repozytorium BOTA. Apka Expo zyje wylacznie na dysku lokalnym.
# Ukosnik na poczatku kotwiczy wzorzec do katalogu glownego, wiec bot/package.json
# i bot/package-lock.json pozostaja sledzone.
# ─────────────────────────────────────────────────────────────────────────────
/App.js
/index.js
/app.json
/eas.json
/package.json
/package-lock.json
/assets/
/AGENTS.md
/CLAUDE.md
/.claude/
/brief-dla-fable.md
/.easignore

# dependencies
node_modules/

# swiece pobrane przez backtester
/bot/cache/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# sekrety bota — klucz portfela i token nigdy nie trafiaja do repo
.env
.env.*
/deploy/.env
# Poswiadczenia Firebase dla powiadomien. Repo jest PUBLICZNE, a ten plik
# zawiera identyfikatory projektu Google — nie ma powodu ich pokazywac.
# Do budowania apki i tak trafia przez .easignore, ktore go nie wyklucza.
/google-services.json
/logs/
# plik blokady tworzony przez deploy/run.sh
.hajsomat.lock
# pliki tymczasowe zapisu stanu (bot pisze do .tmp i podmienia nazwe) — gdyby
# proces zginal miedzy zapisem a podmiana, `git add state` nie ma ich zabierac
/state/*.tmp
wallet.json
wallet-*.json
*.secret

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# ── PRYWATNE: badania i dokumentacja nie wychodza na GitHub ────────────────
# Repozytorium jest publiczne, bo apka czyta state/ przez raw.githubusercontent
# bez tokenu. Publiczne ma byc WYLACZNIE to, co potrzebne do dzialania bota:
# 11 plikow .mjs (graf importow z liga/realny/perpbot/trade/withdraw/kolektor),
# deploy/, .github/ i state/. Cala reszta — rejestr hipotez, README, narzedzia
# laboratoryjne — zostaje lokalnie.
/README.md
/bot/HIPOTEZY.md
/bot/lab-rownolegle.sh
/bot/analiza.mjs
/bot/archiwum.mjs
/bot/backtest.mjs
/bot/beta.mjs
