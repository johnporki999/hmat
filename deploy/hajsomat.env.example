# Ustawienia bota na serwerze. Skopiuj ten plik jako deploy/.env i uzupelnij.
#
#   cp deploy/hajsomat.env.example deploy/.env
#   nano deploy/.env
#
# Plik .env jest w .gitignore, wiec nie trafi do repozytorium.

# ─── Wypychanie stanu do GitHuba ─────────────────────────────────────────────
# Token potrzebny, zeby serwer mogl zapisywac stan do repo (apka go stamtad czyta).
# Zrob go tu: GitHub → Settings → Developer settings → Personal access tokens
#   → Fine-grained tokens → Generate new token
#   Repository access: tylko to jedno repo
#   Permissions → Repository permissions → Contents: Read and write
GITHUB_TOKEN=
GITHUB_REPO=johnporki999/hmat
GIT_BRANCH=main

# ─── Tryb ────────────────────────────────────────────────────────────────────
# Dopoki DRY_RUN=true, bot NICZEGO nie kupuje i klucz portfela nie jest potrzebny.
# Nie wpisuj tu klucza prywatnego, dopoki nie przejdziesz swiadomie na tryb live.
DRY_RUN=true
DRY_START_USDC=125

# SOLANA_PRIVATE_KEY=

# ─── Bot realny na Hyperliquid (bot/realny.mjs) ──────────────────────────────
# Eksperyment na prawdziwych pieniadzach: 20 trejdow, potem bot sam sie wylacza.
# Nie ma zarobic — ma zmierzyc, ile NAPRAWDE kosztuje wejscie i wyjscie.
#
# UWAGA NA KOLEJNOSC: dopoki REALNY_SUCHY=1, klucz nie jest do niczego potrzebny
# i lepiej go tu NIE wklejac. Tryb zywy nie jest jeszcze napisany, wiec dzis bot
# fizycznie nie ma czym zlozyc zlecenia.
REALNY_SUCHY=1

# Publiczny adres twojego portfela MetaMask (0x...). To jawna informacja —
# Hyperliquid odpytuje po niej stan konta. Agent sluzy tylko do PODPISYWANIA,
# a zapytania o saldo trzeba kierowac na adres konta glownego.
# REALNY_KONTO=

# Klucz prywatny PORTFELA AGENTA — tego, ktorego wygenerowales w ustawieniach
# API na Hyperliquid i zatwierdzil podpisem z MetaMaska.
#
# NIGDY nie wklejaj tu klucza z MetaMaska. Agent moze skladac i anulowac
# zlecenia, ale z zalozenia NIE MOZE nic wyplacic ani przelac — dlatego jego
# wyciek oznacza najwyzej zle trejdy, a nie utrate pieniedzy. Klucz MetaMaska
# potrafi wszystko i na serwerze nie ma czego szukac.
#
# Ustaw agentowi date waznosci (max 180 dni) — eksperyment trwa kilka godzin,
# wiec 30 dni w zupelnosci wystarczy.
# REALNY_AGENT_KEY=

# Ile wplacasz i czym gra (puste = domyslne z bot/realny.mjs)
REALNY_START_USD=25
REALNY_GRACZ=smycz
REALNY_MAX_TREJDOW=20

# ─── STADO: kilka botow na prawdziwych pieniadzach ───────────────────────────
# Kazdy bot na WLASNYM koncie Hyperliquid — inaczej gielda widzi jeden rachunek
# i jedna pozycje na rynek, wiec long jednego i short drugiego na tym samym
# aktywie zniosly by sie nawzajem. To nie byloby stado, tylko jeden bot
# o pomieszanych sygnalach.
#
# Subkonta Hyperliquid odpadaja: wymagaja 100 tys. USD obrotu. Zamiast nich
# trzy zwykle portfele EVM, kazdy z wlasnym kluczem agenta.
#
# Kazdy bot potrzebuje: konta (jawny adres 0x...), klucza agenta i kwoty startu.
# Nazwy zmiennych to nazwa gracza WIELKIMI literami.
#
# Minimum na bota przy 2 miejscach po 40% i dzwigni 3x to 8,33 USD, ale to jest
# prog, ponizej ktorego bot MILKNIE — zlecenia zejda pod minimum gieldy (10 USD)
# i przestanie handlowac bez zadnego bledu. Przy 37 USD zapas wynosi 4,4x, czyli
# bot przezyje obsuniecie 77%. Nasze boty miewaja 60-80%, wiec to nie zapas na wyrost.
STADO="smycz sito5 trend"

# KONTO_SMYCZ=0x...
# AGENT_SMYCZ=
# START_SMYCZ=37

# KONTO_SITO5=0x...
# AGENT_SITO5=
# START_SITO5=37

# KONTO_TREND=0x...
# AGENT_TREND=
# START_TREND=37

# ─── Strategia (puste = wartosc domyslna z bot/strategy.mjs) ─────────────────
ASSETS=SOL,JUP,JTO,PYTH,RAY,ORCA,RENDER,BONK,W,TNSR,DRIFT,KMNO,PENGU
MAX_POSITIONS=2
ALLOC_PCT=0.45
MAX_TRADE_USD=60
COST_EDGE_MULT=1

# ─── Bot kontraktowy (symulacja) ─────────────────────────────────────────────
PERP_START_USD=500
PERP_LEVERAGE=3
PERP_MAX_POSITIONS=2
PERP_ALLOW_SHORT=true

# ─── Sieć ────────────────────────────────────────────────────────────────────
# Wlasny wezel dziala pewniej niz publiczny. Potrzebny dopiero w trybie live.
# RPC_URL=

# ─── Powiadomienia na telefon ────────────────────────────────────────────────
# Adres telefonu bierzesz z apki: Ustawienia → Powiadomienia o trejdach →
# "Wlacz powiadomienia", potem dotknij pola, zeby skopiowac.
#
# Bez tej zmiennej powiadomienia sa po prostu wylaczone — bot dziala normalnie.
# Kilka telefonow: po przecinku, bez spacji.
# EXPO_PUSH_TOKEN=ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]
#
# Prog kwotowy w zlotowkach. Pusty albo 0 = kazde zamkniecie (okolo 29 dziennie
# przy obecnym tempie botow). 1 = tylko trejdy powyzej zlotowki, okolo 4-5 dziennie.
# POWIADOM_MIN_ZL=0

# ─── Hamulec bezpieczenstwa (bot realny) ─────────────────────────────────────
# Zlecenie stop skladane NA GIELDZIE zaraz po otwarciu pozycji, jako ulamek
# ceny wejscia. To NIE jest stop strategii — ten zostaje w bocie. Hamulec stoi
# duzo dalej i ma zadzialac tylko wtedy, gdy bot nie zdazy albo serwer nie wstanie.
#
# 0.25 = 25% od wejscia. Pomiar na 119 trejdach na zywo: cena odeszla najdalej
# o 2,06%, wiec zaden z nich by go nie dotknal. Likwidacja przy dzwigni 3x lezy
# okolo 33%, wiec hamulec jest przed nia. 0 wylacza.
# REALNY_HAMULEC=0.25
