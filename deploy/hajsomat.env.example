# Ustawienia bota na serwerze. Skopiuj ten plik jako deploy/.env i uzupelnij.
#
#   cp deploy/hajsomat.env.example deploy/.env
#   nano deploy/.env
#
# Plik .env jest w .gitignore, wiec nie trafi do repozytorium.

# ─── Wypychanie stanu do GitHuba ─────────────────────────────────────────────
# Token potrzebny, zeby serwer mogl zapisywac stan do repo (apka go stamtad czyta).
# Zrob go tu: GitHub → Settings → Developer settings → Personal access tokens
#   → Fine-grained tokens → Generate new token
#   Repository access: tylko to jedno repo
#   Permissions → Repository permissions → Contents: Read and write
GITHUB_TOKEN=
GITHUB_REPO=johnporki999/hmat
GIT_BRANCH=main

# ─── Tryb ────────────────────────────────────────────────────────────────────
# Dopoki DRY_RUN=true, bot NICZEGO nie kupuje i klucz portfela nie jest potrzebny.
# Nie wpisuj tu klucza prywatnego, dopoki nie przejdziesz swiadomie na tryb live.
DRY_RUN=true
DRY_START_USDC=125

# SOLANA_PRIVATE_KEY=

# ─── Bot realny na Hyperliquid (bot/realny.mjs) ──────────────────────────────
# Eksperyment na prawdziwych pieniadzach: 20 trejdow, potem bot sam sie wylacza.
# Nie ma zarobic — ma zmierzyc, ile NAPRAWDE kosztuje wejscie i wyjscie.
#
# UWAGA NA KOLEJNOSC: dopoki REALNY_SUCHY=1, klucz nie jest do niczego potrzebny
# i lepiej go tu NIE wklejac. Tryb zywy nie jest jeszcze napisany, wiec dzis bot
# fizycznie nie ma czym zlozyc zlecenia.
REALNY_SUCHY=1

# Publiczny adres twojego portfela MetaMask (0x...). To jawna informacja —
# Hyperliquid odpytuje po niej stan konta. Agent sluzy tylko do PODPISYWANIA,
# a zapytania o saldo trzeba kierowac na adres konta glownego.
# REALNY_KONTO=

# Klucz prywatny PORTFELA AGENTA — tego, ktorego wygenerowales w ustawieniach
# API na Hyperliquid i zatwierdzil podpisem z MetaMaska.
#
# NIGDY nie wklejaj tu klucza z MetaMaska. Agent moze skladac i anulowac
# zlecenia, ale z zalozenia NIE MOZE nic wyplacic ani przelac — dlatego jego
# wyciek oznacza najwyzej zle trejdy, a nie utrate pieniedzy. Klucz MetaMaska
# potrafi wszystko i na serwerze nie ma czego szukac.
#
# Ustaw agentowi date waznosci (max 180 dni) — eksperyment trwa kilka godzin,
# wiec 30 dni w zupelnosci wystarczy.
# REALNY_AGENT_KEY=

# Ile wplacasz i czym gra (puste = domyslne z bot/realny.mjs)
REALNY_START_USD=25
REALNY_GRACZ=smycz
REALNY_MAX_TREJDOW=20

# ─── Strategia (puste = wartosc domyslna z bot/strategy.mjs) ─────────────────
ASSETS=SOL,JUP,JTO,PYTH,RAY,ORCA,RENDER,BONK,W,TNSR,DRIFT,KMNO,PENGU
MAX_POSITIONS=2
ALLOC_PCT=0.45
MAX_TRADE_USD=60
COST_EDGE_MULT=1

# ─── Bot kontraktowy (symulacja) ─────────────────────────────────────────────
PERP_START_USD=500
PERP_LEVERAGE=3
PERP_MAX_POSITIONS=2
PERP_ALLOW_SHORT=true

# ─── Sieć ────────────────────────────────────────────────────────────────────
# Wlasny wezel dziala pewniej niz publiczny. Potrzebny dopiero w trybie live.
# RPC_URL=
